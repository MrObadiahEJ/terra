{
    // Keep heavy build artifacts out of file watching/search.
    "files.watcherExclude": {
        "**/terra-core/target/**": true,
        "**/terra-web/node_modules/**": true,
        "**/terra-core/node_modules/**": true,
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true
    },
    "search.exclude": {
        "**/terra-core/target": true,
        "**/terra-web/node_modules": true,
        "**/terra-core/node_modules": true
    },

    // Rust formatting stays with cargo fmt (make / CI), not editor-on-save.
    "[rust]": {
        "editor.formatOnSave": false
    },
    "chat.tools.terminal.autoApprove": {
        "cargo fmt": true,
        "cargo test": true,
        "npx eslint": true,
        "cargo check": true,
        "npm run dev": true,
        "sha256sum": true,
        "git remote": true,
        "git add": true,
        "git commit": true,
        "git push": true,
        "git ls-remote": true,
        "gh": true,
        "anchor": true,
        "pnpm": true,
        "rustfmt": true,
        "exit": true,
        "npm test": true
    }
}
