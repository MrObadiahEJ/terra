# terra-web environment
# Copy to .env.local for local development. Never commit secrets.

# Backend API base URL. Default in code is /api/v1 (same-origin / Vite proxy).
# For a hosted API: https://<your-service>.onrender.com/api/v1
VITE_API_BASE=http://localhost:8080/api/v1

# Solana RPC URL. Terra program IDs are devnet/localnet — use devnet for testing.
# Prefer a private RPC (Helius/QuickNode/etc.) over public devnet for reliability.
VITE_TERRA_RPC_URL=https://api.devnet.solana.com

# E2E / testing only — never set in production builds.
# VITE_TERRA_E2E_SECRET_KEY=
# VITE_TERRA_VRF_ORACLE_SECRET=
