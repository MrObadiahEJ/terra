# terra-api configuration
# Copy to .env and adjust if needed. Never commit a populated .env.

# --- Required ---------------------------------------------------------------
# Postgres with the PostGIS and pgcrypto extensions. Supabase/Neon free tiers
# work; append `?sslmode=require` for managed providers.
DATABASE_URL=postgres://terra:terra@localhost:5432/terra_dev

HOST=0.0.0.0
PORT=8080
RUST_LOG=info

# --- Chain ------------------------------------------------------------------
# Solana RPC used by the background indexer. Use a free Helius/QuickNode devnet
# endpoint; the public api.devnet.solana.com endpoint is rate-limited.
# Example devnet Helius URL (replace <API_KEY> with your own key — never commit it):
#   https://devnet.helius-rpc.com/?api-key=<API_KEY>&rebate-address=<WALLET_PUBKEY>
TERRA_RPC_URL=https://api.devnet.solana.com

# --- Auth -------------------------------------------------------------------
# Ed25519 public key (base58) allowed to sign privileged requests. When unset,
# privileged endpoints reject every caller (fail-closed).
API_AUTHORITY_PUBKEY=

# Ed25519 public key (base58) of the storage-PoP oracle. Proof-of-possession
# fails closed when unset: challenges are not issued and `prove_replica`
# returns 503. There is no SHA-256 fallback.
VRF_ORACLE_PUBKEY=

# --- Zero-knowledge membership proofs (RFC-011) -----------------------------
# off (default) | development | production
#   off/disabled : proof endpoints return 503
#   development  : load a dev proving key; generate/prepare are loopback-only
#   production   : load only the verifying key (no server-side proving)
# Generate dev keys with `make zk-dev-setup` (writes terra-core/.zk/env.sh).
TERRA_ZK_MODE=disabled
TERRA_ZK_VERIFYING_KEY_PATH=
TERRA_ZK_PROVING_KEY_PATH=

# --- CORS -------------------------------------------------------------------
# Comma-separated allowed browser origins. Set this to the deployed Pages
# origin, e.g. https://<user>.github.io. Defaults to localhost:5173 only.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Evidence storage -------------------------------------------------------
# Durability matters: Render's local disk is ephemeral. Set all four S3 values
# to use an S3-compatible bucket (Filebase free tier, Cloudflare R2, MinIO).
# The bucket must be private because evidence can be quarantined.
# S3_BUCKET=terra-evidence
# S3_ENDPOINT=https://s3.filebase.com
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1

# Fallback when no S3 backend is configured (local development only).
EVIDENCE_STORAGE_DIR=/tmp/terra-evidence

# --- Limits -----------------------------------------------------------------
# Maximum request body. Default 64 MiB covers multipart OSM ingest and photos.
MAX_BODY_BYTES=67108864
REQUEST_TIMEOUT_SECS=60

# --- Optional geo -----------------------------------------------------------
# Enables /api/v1/geo endpoints (road access + POIs).
# OSM_PBF_PATH=../data/liechtenstein-latest.osm.pbf
